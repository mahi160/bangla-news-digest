---
// Reader-side display filter only -- doesn't change what's fetched, emailed,
// or put in the EPUB/RSS/OPDS, and only ships on the index page (today's
// editions), not archive permalinks. Hides via the native `hidden` attribute
// (see the `.row[hidden]` override in global.css), so Modal's existing
// visibleRows()/offsetParent check already skips filtered-out rows for free.
//
// Known simplification: category chip counts still show the day's total,
// not the filtered count. Fine for a hide-some-sources toggle.
import { SOURCES } from "../lib/config";

// Configured sources, de-duplicated by name (first occurrence wins), in
// config.ts order -- always the full list regardless of which sources
// happen to have articles today, so the toggle set doesn't shuffle around
// day to day. Each also links out to the outlet's own site (its feed URL's
// origin), opened in a new tab.
const uniqueSources = [...new Map(SOURCES.map((s) => [s.name, s])).values()];
---

<details class="srcfilter">
	<summary>উৎস ফিল্টার</summary>
	<div class="srclist">
		{
			uniqueSources.map((s) => {
				let origin = "#";
				try {
					origin = new URL(s.url).origin;
				} catch {
					/* malformed source url -- link falls back to # */
				}
				return (
					// <a> is a *sibling* of the checkbox, not nested inside a shared
					// <label> -- nesting a link inside a checkbox's label makes some
					// browsers toggle the checkbox on link click too, which isn't
					// what "open this source" should do.
					<span class="src-item">
						<input type="checkbox" value={s.name} checked aria-label={`উৎস ফিল্টার: ${s.name}`} />
						<a href={origin} target="_blank" rel="noopener noreferrer">{s.name}</a>
					</span>
				);
			})
		}
	</div>
</details>

<script>
	(function () {
		const KEY = "nd-hidden-sources";
		function hiddenSet(): Set<string> {
			try {
				return new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));
			} catch {
				return new Set();
			}
		}
		function apply(hidden: Set<string>) {
			const boxes = document.querySelectorAll<HTMLInputElement>(".srclist input[type=checkbox]");
			boxes.forEach((box) => (box.checked = !hidden.has(box.value)));
			const rows = document.querySelectorAll<HTMLElement>(".row");
			rows.forEach((row) => (row.hidden = hidden.has(row.dataset.source ?? "")));
		}
		apply(hiddenSet());
		document.addEventListener("change", (e) => {
			const box = (e.target as HTMLElement).closest<HTMLInputElement>(
				".srclist input[type=checkbox]",
			);
			if (!box) return;
			const hidden = hiddenSet();
			if (box.checked) hidden.delete(box.value);
			else hidden.add(box.value);
			localStorage.setItem(KEY, JSON.stringify(Array.from(hidden)));
			apply(hidden);
		});
	})();
</script>
